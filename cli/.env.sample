# Copy to cli/.env (or ./.env, or pass --env-file). Values shown are the built-in defaults.
# Precedence: command-line flag > environment variable > .env file > default.

# Required - never passed as flags
VISTA_ACCESS_CODE=
VISTA_VERIFY_CODE=

# Connection (only dev and sqa are allowed; prod is always blocked)
APPT_ENV=sqa
VISTA_HOST=vista.example.com
VISTA_PORT=9094
VISTA_CONTEXT=CDSP RPC CONTEXT
VISTA_STATION=500

# Patient (blank = random test patient)
APPT_DFN=

# Clinics
APPT_CLINIC=195
APPT_PRIMARY_CLINIC=532
APPT_ANCILLARY_CLINIC=521
APPT_GROUP_CLINICS=478,485
APPT_BLOCK_CLINIC=478

# Behavior
APPT_SEARCH_DAYS=30
APPT_TZ=America/New_York
APPT_CLOSE_DISPOSITION=6
