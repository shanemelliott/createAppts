# Port for the API server
PORT=4010

# STS Token Generator Configuration
# Environment: sqa, preprod, or prod
STS_ENV=preprod

# Optional: PIV card serial number (if multiple certs available)
# PIV_SERIAL=

# Optional: Override STS exe path (defaults to ./sts-token/sts-token-generator.exe)
# STS_EXE=

# VistA Configuration (if using VistA BSE client directly)
VISTA_HOST=vista.example.com
VISTA_PORT=9094
VISTA_CONTEXT=CDSP RPC CONTEXT
VISTA_STATION=500

# CWS API Configuration
CWS_API_BASE_URL=https://staging.example.com/cws-api/v1
VISTA_SITE_ID=500

# Legacy: VistA API X Configuration (if still needed)
# VISTA_API_BASE_URL=https://vista-api-x.example.com/api
# VISTA_API_KEY=your-api-key

# SSL Configuration
# Set to 0 to disable SSL verification (non-production only)
# NODE_TLS_REJECT_UNAUTHORIZED=1
